{
	// Compiler options from VS Code's src/tsconfig.base.json. The one difference is module
	// resolution: VS Code runs native ES modules in development, Dotwork always bundles with
	// esbuild, so it resolves like a bundler (the `.js` import suffixes work the same way).
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "legacy",
		"experimentalDecorators": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUncheckedSideEffectImports": true,
		"allowUnreachableCode": false,
		"strict": true,
		"exactOptionalPropertyTypes": false,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"target": "ES2024",
		"useDefineForClassFields": false,
		"lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
		"types": ["node", "mocha", "sinon", "trusted-types"],
		"esModuleInterop": true,
		"preserveConstEnums": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/typings", "src/vs/**/*.ts"]
}
