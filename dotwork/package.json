{
  "name": "dotwork",
  "version": "1.0.0",
  "description": "A desktop IDE built on the same stack as VS Code: Electron, TypeScript, Monaco and TextMate grammars",
  "main": "./out/vs/code/electron-main/main.js",
  "author": "example.com",
  "scripts": {
    "compile": "gulp compile",
    "watch": "gulp watch",
    "start": "electron .",
    "dev": "gulp compile && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --cache .",
    "test": "gulp compile && mocha",
    "build": "npm run typecheck && gulp compile",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "format": "node build/format.mjs",
    "format:check": "node build/format.mjs --check"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.57.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/sinon": "^10.0.20",
    "@types/trusted-types": "^2.0.7",
    "electron": "43.7.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "10.8.0",
    "gulp": "^4.0.2",
    "mocha": "^10.8.2",
    "sinon": "^12.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
