{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Dotwork",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [".", "--remote-debugging-port=9222"],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    },
    {
      "name": "Attach to Workbench",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "timeout": 60000
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Launch Dotwork", "Attach to Workbench"]
    }
  ]
}
